# Copy to apps/mobile/.env. Expo reads this folder's .env, not the one at the repo root.
# EXPO_PUBLIC_ values are built into the app, so never put a secret here.
# For EAS builds, set the same names with `eas env:create --environment preview`.

# The API's address as the phone sees it. On the same Wi-Fi during development,
# use your computer's address, e.g. http://192.168.1.20:3000. Only debug builds
# allow plain http; an APK needs https.
EXPO_PUBLIC_API_URL=

# Clerk dashboard > API keys > Publishable key (pk_test_... or pk_live_...).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Two-letter country code for Home's trending list.
EXPO_PUBLIC_CHART_COUNTRY=gb

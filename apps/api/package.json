{
  "name": "@pluck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "token": "node --env-file-if-exists=../../.env scripts/token.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@clerk/backend": "^3.27.0",
    "@pluck/catalog": "workspace:*",
    "@pluck/contracts": "workspace:*",
    "@pluck/core": "workspace:*",
    "@pluck/db": "workspace:*",
    "@pluck/messaging": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "pino-pretty": "^13.2.0"
  }
}

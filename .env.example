# Local development. Copy to .env and fill in the values marked "Required".
# The API and the worker both read this file. The defaults match compose.yaml.
# A blank value counts as not set.

NODE_ENV=development
LOG_LEVEL=info

# ---------- API ----------

PORT=3000

# Required. The secret key from the API keys page of the Clerk dashboard.
CLERK_SECRET_KEY=
# Optional. Same page > Show JWT public key > PEM public key, pasted on one line.
# With it, the API checks sign-in tokens without calling Clerk.
CLERK_JWT_KEY=
# Required. Your user id (user_...), from Users in the Clerk dashboard.
# Separate several with commas. Anyone else who signs in is refused.
CLERK_ALLOWED_USER_IDS=

DATABASE_URL=postgres://pluck:pluck@localhost:5433/pluck
RABBITMQ_URL=amqp://pluck:pluck@localhost:5672

# Local storage (RustFS in compose.yaml) stands in for Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
# The address your phone uses to reach storage: your computer's address on the
# Wi-Fi, e.g. http://192.168.1.20:9000. Upload and download links are made for it.
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pluck
S3_ACCESS_KEY_ID=pluck-dev
S3_SECRET_ACCESS_KEY=pluck-dev-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Required. Shared by the API and the worker. Make one with: openssl rand -base64 48
WORKER_TOKEN=

# Optional. Turns on YouTube search in the app. Google Cloud console > APIs > YouTube Data API v3.
YOUTUBE_API_KEY=
# The country whose charts Home shows, as a two-letter code.
CATALOG_COUNTRY=gb

# ---------- Worker ----------

API_URL=http://localhost:3000
WORKER_CONCURRENCY=2

# Only needed when the tools are not on your PATH, e.g. C:\tools\ffmpeg\bin\ffmpeg.exe
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
PYTHON_PATH=
# A cookies.txt exported from a browser signed in to YouTube. Only needed for
# age-restricted videos, or when YouTube asks to confirm you are not a bot.
YTDLP_COOKIES_FILE=

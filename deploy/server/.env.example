# Copy to deploy/server/.env on the server and fill in. Docker Compose reads it from this folder.
# A blank value counts as not set. docs/deploy.md says where each value comes from.

# Make each with: openssl rand -hex 24
# Hex only, because these go inside connection URLs, where symbols would need escaping.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

LOG_LEVEL=info

# ---------- Clerk ----------

# Clerk dashboard > API keys > Secret key.
CLERK_SECRET_KEY=
# Optional. Same page > Show JWT public key > PEM public key, pasted on one line.
CLERK_JWT_KEY=
# Your user id (user_...), from Users in the Clerk dashboard.
CLERK_ALLOWED_USER_IDS=

# ---------- Cloudflare R2 ----------

# R2 > Overview > the "S3 API" address, without the bucket name on the end.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=audiostash
# R2 > Manage API tokens > Create API token, with Object Read & Write on this bucket only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# The bucket is made in the Cloudflare dashboard, and the token cannot make buckets.
S3_CREATE_BUCKET=false

# ---------- Worker and catalog ----------

# Make one with: openssl rand -base64 48
# deploy/worker/.env on your PC must hold the same value.
WORKER_TOKEN=

# Optional. Turns on YouTube search in the app.
YOUTUBE_API_KEY=
CATALOG_COUNTRY=gb

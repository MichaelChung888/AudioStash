# Deploys the newest release. audiostash-update.timer starts it every two minutes.
# docs/deploy.md (Part 2, step 4) says how to install it.
[Unit]
Description=Deploy the newest AudioStash release
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/AudioStash
# Run by bash, so the script needs no executable bit, which git on Windows does not record.
ExecStart=/bin/bash deploy/server/update.sh
# Makes /var/lib/audiostash-update, owned by ubuntu, and passes it as STATE_DIRECTORY.
StateDirectory=audiostash-update

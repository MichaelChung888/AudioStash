# Copy to deploy/worker/.env and fill in. Docker Compose reads it from this folder.

# Tailscale admin console > Settings > Keys > Generate auth key.
TS_AUTHKEY=

# The cloud server's Tailscale IP address (100.x.y.z), from the Machines page of the
# Tailscale admin console. An IP address avoids depending on DNS inside the container.
API_URL=http://100.x.y.z:3000
# Also replace the word RABBITMQ_PASSWORD with the value of RABBITMQ_PASSWORD in the
# server's deploy/server/.env. Otherwise RabbitMQ refuses the login (ACCESS_REFUSED).
RABBITMQ_URL=amqp://audiostash:RABBITMQ_PASSWORD@100.x.y.z:5672

# The same value as WORKER_TOKEN on the server.
WORKER_TOKEN=

# Songs processed at once.
WORKER_CONCURRENCY=2
